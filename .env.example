# MAX Bot API
MAX_BOT_TOKEN=
# Положительный int64. Подробности получения: docs/OPERATIONS.md
MAX_CHAT_ID=
MAX_API_BASE=https://platform-api2.max.ru
# Секрет подписки MAX Webhook: 5-256 символов A-Z, a-z, 0-9, "_", "-"
MAX_WEBHOOK_SECRET=
# Публичный HTTPS URL для автоматической регистрации Webhook (необязательно)
MAX_WEBHOOK_URL=
MAX_WEBHOOK_UPDATE_TYPES=message_callback,bot_started,bot_added,bot_removed,bot_admin_permissions_changed

# MegaPBX webhook/API
MEGAPBX_CRM_TOKEN=
MEGAPBX_ALLOWED_GROUP=
MEGAPBX_ALLOWED_DID=
MEGAPBX_DID_NAMES=
MEGAPBX_API_BASE=
MEGAPBX_API_TOKEN=
MEGAPBX_ALLOW_QUERY_TOKEN=0
MEGAPBX_ALLOW_ALL=0
MEGAPBX_ALLOW_HTTP_API=0
MEGAPBX_WEBHOOK_BODY_BYTES=1048576
MEGAPBX_ENRICHMENT_REFRESH_SEC=600

# Runtime
STATE_DB_PATH=data/state.sqlite3
# Optional explicit CA bundle; installer sets the Debian/Ubuntu system bundle.
# SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt
TZ_OFFSET_HOURS=3
MISSED_MAX_AGE_SEC=3600
MISSED_CLEANUP_INTERVAL_SEC=3600
MISSED_DEDUP_TTL_SEC=86400
JOB_MAX_ATTEMPTS=20
JOB_RETRY_BASE_SEC=1
JOB_RETRY_MAX_SEC=300
JOB_LEASE_SEC=300
MAX_API_MAX_RETRIES=2
MAX_API_RETRY_BASE_SEC=0.5
MAX_API_RETRY_MAX_SEC=8
MAX_API_TIMEOUT_SEC=8
MAX_WEBHOOK_BODY_BYTES=1048576
